# All optional. Without keys: local Whisper transcription + a keyword matcher for recall prompts.

# Post-session transcription: local (default, free Whisper in-process) | openai | assemblyai | none
# TRANSCRIBE_PROVIDER=local
# LOCAL_WHISPER_MODEL=onnx-community/whisper-base_timestamped
# PLAYTEST_MODEL_DIR=./.models
# TRANSCRIBE_MODEL=whisper-1        # for openai
# ASSEMBLYAI_API_KEY=

# Recall prompt provider: gemini | openai | anthropic | mock (auto-detected from keys if unset)
# RECALL_PROVIDER=gemini
# RECALL_MODEL=gemini-2.5-flash-lite
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_API_KEY=

# PLAYTEST_DATA_DIR=./data
