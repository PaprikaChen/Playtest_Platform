# All optional. Without keys the app uses live browser captions + a keyword matcher.

# Post-session transcription
# ASSEMBLYAI_API_KEY=

# Recall prompt provider: gemini | openai | anthropic | mock (auto-detected from keys if unset)
# RECALL_PROVIDER=gemini
# RECALL_MODEL=gemini-2.5-flash-lite
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_API_KEY=

# PLAYTEST_DATA_DIR=./data
